# ============================================================================
# Configuración del Reproductor de Video Distribuido (Entorno Dev)
# Copiar este archivo a `.env` antes de levantar el sistema:
#   cp .env.example .env
# ============================================================================

# --- Base de Datos PostgreSQL (postgres:18.4-bookworm) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=videoapp_dev
DB_USERNAME=videoapp
DB_PASSWORD=videoapp_dev_pass
# DB_URL es opcional; si no se especifica, se construye a partir de las variables anteriores:
# DB_URL=postgresql://videoapp:videoapp_dev_pass@localhost:5434/videoapp_dev

# --- Redis (Broker Celery + Cache LRU de Segmentos) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL es opcional; si no se especifica, se construye a partir de REDIS_HOST y REDIS_PORT:
# REDIS_URL=redis://localhost:6379/0

# --- Servidor TCP ---
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
MAX_CLIENTS=50

# --- Almacenamiento de Videos y Streaming ---
VIDEOS_DIR=/data/videos
MAX_UPLOAD_MB=500
SEG_LEN=4
QUALITIES=480,720
PREFETCH=3

# --- Supervisor (Autoescalado de Workers) ---
MIN_WORKERS=1
MAX_WORKERS=6
TASKS_PER_WORKER=4
